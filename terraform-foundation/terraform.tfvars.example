# Example Terraform variables for CloudGuard SecOps Foundation
# Copy this file to terraform.tfvars and update with your GCP details:
#   cp terraform.tfvars.example terraform.tfvars

project_id                 = "your-gcp-project-id"
region                     = "europe-west2"
organization_id            = "123456789012"
pubsub_topic_name          = "scc-high-alerts-topic"
pubsub_subscription_name   = "scc-high-alerts-sub"
scc_notification_config_id = "scc-high-alerts-config"
