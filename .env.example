# =============================================================================
# CloudGuard SecOps Assistant - Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# Google Cloud Platform (GCP)
PROJECT_ID="your-gcp-project-id"
GCP_REGION="europe-west2"
ORGANIZATION_ID=""

# Pub/Sub Configuration
PUBSUB_TOPIC_NAME="scc-high-alerts-topic"
PUBSUB_SUBSCRIPTION_NAME="scc-high-alerts-sub"
SCC_NOTIFICATION_CONFIG_ID="scc-high-alerts-config"

# Vertex AI Configuration
VERTEX_AI_LOCATION="europe-west2"
VERTEX_AI_MODEL="gemini-2.5-flash"

# Google Chat Integration
GOOGLE_CHAT_WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN"
GOOGLE_CHAT_SPACE_ID="SPACE_ID"

# GitHub Integration (for automated GitOps Pull Requests)
GITHUB_TOKEN="ghp_or_gho_your_github_token"
GITHUB_REPO="your-github-username/your-repo-name"
GITHUB_BASE_BRANCH="main"

# Remediation Receiver Service URL (populated after deploying Cloud Run / Cloud Function)
REMEDIATION_RECEIVER_URL=""
